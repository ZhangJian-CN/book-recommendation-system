QMainWindow, QWidget#centralwidget { background: #F5F6F2; }
QWidget { color: #22352C; font-family: "Microsoft YaHei UI"; font-size: 10pt; }
QFrame[role="card"], QFrame#metrics {
    background: #FFFFFF;
    border: 1px solid #E0E6DE;
    border-radius: 12px;
}
QLabel { background: transparent; border: none; }
QLabel[role="systemTitle"] { font-size: 21px; font-weight: 600; }
QLabel[role="pageTitle"] { font-size: 18px; font-weight: 600; }
QLabel[role="sectionTitle"] { font-size: 15px; font-weight: 600; }
QLabel[role="muted"] { color: #647068; font-size: 12px; }
QLabel[role="metricValue"] { font-family: "Segoe UI"; font-size: 20px; font-weight: 600; }
QLabel[role="guidanceTitle"] { color: #4E6557; font-size: 12px; font-weight: 600; }
QLabel[role="guidance"] { color: #647068; font-size: 12px; }
QLabel[role="selection"] {
    color: #245C4D;
    background: #EAF2ED;
    border-radius: 6px;
    padding: 8px;
}
QLabel[role="empty"] {
    color: #647068;
    background: #F5F6F2;
    border-radius: 6px;
    padding: 14px;
}
QTabWidget::pane { border: none; background: transparent; }
QTabBar { background: #F0F3EE; border: 1px solid #E0E6DE; border-radius: 10px; }
QTabBar::tab {
    background: transparent; color: #647068; font-size: 13px;
    padding: 8px 14px; margin: 4px 3px;
    border: 1px solid transparent; border-radius: 7px;
}
QTabBar::tab:selected { background: white; color: #245C4D; border-color: #DCE4D9; font-weight: 600; }
QTabBar::tab:hover:!selected { background: #E8EEE5; color: #22352C; }
QTabBar::tab:focus { border: 1px solid #245C4D; }
QLineEdit, QSpinBox {
    background: #FAFBF8;
    border: 1px solid #E0E6DE;
    border-radius: 7px;
    padding: 5px 9px;
    selection-background-color: #245C4D;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QSpinBox:hover { background: white; }
QLineEdit:focus { background: white; border: 2px solid #245C4D; padding: 4px 8px; }
QLineEdit:disabled, QSpinBox:disabled { background: #F5F6F2; color: #9BA79F; }
/* Qt also reserves 28 px for the step control: 42 + 28 leaves 70 px on the right. */
QSpinBox { padding: 5px 42px 5px 9px; }
QSpinBox:focus { background: white; border: 1px solid #245C4D; padding: 5px 42px 5px 9px; }
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 6px;
    background: #F5F6F2;
}
QSpinBox::up-button { right: 4px; }
QSpinBox::down-button { right: 34px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #EAF2ED; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed { background: #DCEADF; }
QSpinBox::up-button:disabled, QSpinBox::up-button:off,
QSpinBox::down-button:disabled, QSpinBox::down-button:off { background: #F5F6F2; }
QSpinBox::up-arrow, QSpinBox::down-arrow { width: 12px; height: 12px; }
QSpinBox::up-arrow { image: url(:/ui/icons/spin-plus.png); }
QSpinBox::down-arrow { image: url(:/ui/icons/spin-minus.png); }
QSpinBox::up-arrow:hover { image: url(:/ui/icons/spin-plus-hover.png); }
QSpinBox::down-arrow:hover { image: url(:/ui/icons/spin-minus-hover.png); }
QSpinBox::up-arrow:pressed { image: url(:/ui/icons/spin-plus-pressed.png); }
QSpinBox::down-arrow:pressed { image: url(:/ui/icons/spin-minus-pressed.png); }
QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off { image: url(:/ui/icons/spin-plus-disabled.png); }
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off { image: url(:/ui/icons/spin-minus-disabled.png); }
QPushButton {
    background: #FFFFFF;
    border: 1px solid #E0E6DE;
    border-radius: 7px;
    padding: 5px 10px;
}
QPushButton:hover { background: #F5F6F2; border-color: #BDCCBE; }
QPushButton:pressed { background: #EAF2ED; }
QPushButton[role="primary"] { background: #245C4D; border-color: #245C4D; color: #FFFFFF; }
QPushButton[role="primary"]:hover { background: #1C4C40; border-color: #1C4C40; }
QPushButton[role="danger"] { color: #A83B32; background: transparent; border-color: transparent; }
QPushButton[role="danger"]:hover { background: #F7E7E2; }
QPushButton:focus { border: 2px solid #245C4D; padding: 4px 9px; }
QPushButton[role="primary"]:focus { border: 2px solid #22352C; }
QPushButton:disabled, QPushButton[role="primary"]:disabled, QPushButton[role="danger"]:disabled {
    color: #9BA79F;
    background: #EDF1EB;
    border-color: #E0E6DE;
}
QTableWidget {
    background: #FFFFFF;
    border: none;
    border-radius: 0;
    selection-background-color: #EAF2ED;
    selection-color: #22352C;
}
QTableWidget::item { padding: 5px 9px; }
QTableWidget::item:selected { background: #EAF2ED; color: #22352C; }
QTableWidget:focus { border: none; border-radius: 0; }
QHeaderView::section {
    background: #F6F8F3;
    color: #647068;
    font-size: 12px;
    font-weight: 500;
    border: none;
    border-bottom: 1px solid #E0E6DE;
    padding: 7px 12px;
}
QTableCornerButton::section { background: #F5F6F2; border: none; }
QScrollArea { background: transparent; border: none; }
QWidget#formBody { background: transparent; }
QScrollBar:vertical { background: #F5F6F2; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #C5CFC4; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QStatusBar { background: #F5F6F2; color: #647068; }
QStatusBar::item { border: none; }
QPushButton#dataDirectoryButton { background: transparent; border: none; color: #245C4D; }
QDialog, QMessageBox { background: #F5F6F2; }

QLabel[role="count"] { color: #647068; background: #F0F3EE; font-size: 12px; padding: 3px 8px; border-radius: 5px; }
QLabel[role="selectedTitle"] { font-size: 14px; font-weight: 600; }
QFrame#bookSelectionCard { background: #F0F3EE; border: 1px solid transparent; border-radius: 8px; }
QFrame#bookSelectionCard[selected="true"] { background: #FAFBF8; border-color: #EDF0EA; }
QLabel[role="selection"] { font-size: 12px; background: #F0F3EE; color: #647068; }
QFrame[role="separator"] { background: #EDF0EA; border: none; }
QFrame[role="metricSeparator"] { background: #E0E6DE; border: none; }
QHeaderView::section:vertical { background: white; font-size: 12px; font-weight: 400; border: none; }
QAbstractItemView#idCompletionPopup { background: white; border: 1px solid #E0E6DE; border-radius: 7px; selection-background-color: #EAF2ED; selection-color: #22352C; }
QAbstractItemView#idCompletionPopup::item { padding: 7px 9px; min-height: 22px; border: none; }
QToolTip { color: #22352C; background: #FAFBF8; border: 1px solid #E0E6DE; padding: 6px; }
QStatusBar { color: #245C4D; font-size: 12px; }
QStatusBar[error="true"] { color: #A83B32; }
